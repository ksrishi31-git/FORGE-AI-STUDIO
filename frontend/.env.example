# ForgeAI Studio — Frontend environment template
# Copy to `.env.local` for local development. Never commit real values.
# Consumed by `lib/config/env.ts` and validated with Zod (FAD §5.4).

# API routing — pick exactly ONE mode:
#
# 1) Same-origin proxy (recommended for local dev): leave NEXT_PUBLIC_API_URL
#    EMPTY and point API_PROXY_TARGET at the API service. Requests go through
#    the Next.js /api rewrite, so the auth cookie stays same-origin and
#    middleware protection works identically to the containerized topology.
# 2) Direct cross-origin: set NEXT_PUBLIC_API_URL to the API base. The refresh
#    cookie then lives on the API origin, so middleware cookie checks on the
#    web origin will not see it — use mode 1 unless you know you need this.
NEXT_PUBLIC_API_URL=

# Destination for the same-origin /api proxy (next.config.ts). The Compose
# default hostname is http://api:8000; local development uses http://localhost:8000.
API_PROXY_TARGET=http://localhost:8000

# WebSocket / SSE endpoint for live run events (Phase 3.2+)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events

# Canonical application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Refresh-token cookie name (backend convention)
NEXT_PUBLIC_AUTH_COOKIE=forgeai_refresh
