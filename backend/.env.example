# =============================================================================
# ForgeAI Studio — Backend environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# All variables are consumed by `app/config/settings.py`.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=ForgeAI Studio
DEBUG=false
API_PREFIX=/api/v1

# --- CORS (JSON array; the API service mirrors this on the frontend) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (SQLAlchemy async URL) ---
DATABASE_URL=postgresql+asyncpg://forgeai:forgeai@localhost:5432/forgeai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (queues, streams, cache). Leave empty to disable. ---
REDIS_URL=redis://localhost:6379/0

# --- Security (dev values only — rotate in staging/production) ---
SECRET_KEY=change-me-in-production
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PEM=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- LLM providers (consumed from Phase 3.2+) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# --- Storage (artifacts, exports) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# --- ChromaDB (vector memory, consumed from Phase 3.2+) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=

# --- Password reset / email (empty SMTP = dev mode: reset link returned in API) ---
RESET_TOKEN_TTL_MINUTES=60
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
